# アプリケーション設定
# Application Configuration
APP_NAME=Salary                    # アプリケーション名
APP_ENV=local                      # 実行環境 (local, production等)
APP_KEY=                           # アプリケーション暗号化キー (php artisan key:generate で生成)
APP_DEBUG=true                     # デバッグモード (本番環境では false に設定)
APP_URL=http://localhost:8000      # アプリケーションのベースURL

# ログ設定
# Logging Configuration
LOG_CHANNEL=stack                  # ログチャンネル (stack, single, daily等)
LOG_DEPRECATIONS_CHANNEL=null      # 非推奨警告のログチャンネル
LOG_LEVEL=debug                    # ログレベル (debug, info, warning, error)

# データベース設定
# Database Configuration
DB_CONNECTION=mysql                # データベースタイプ
DB_HOST=127.0.0.1                 # データベースサーバーのホスト
DB_PORT=3306                      # データベースサーバーのポート
DB_DATABASE=salary                # データベース名
DB_USERNAME=root                  # データベースユーザー名
DB_PASSWORD=                      # データベースパスワード

# システム設定
# System Configuration
BROADCAST_DRIVER=log              # ブロードキャスト配信方法
CACHE_DRIVER=file                 # キャッシュドライバー (file, redis, database等)
FILESYSTEM_DRIVER=local           # ファイルシステムドライバー
QUEUE_CONNECTION=sync             # キュー処理方法 (sync, database等)
SESSION_DRIVER=database           # セッション保存方法
SESSION_LIFETIME=120              # セッション有効期限 (分)

# メール設定
# Mail Configuration
MAIL_MAILER=smtp                  # メール送信方法 (smtp, sendmail等)
MAIL_HOST=localhost               # SMTPサーバーのホスト
MAIL_PORT=1025                    # SMTPサーバーのポート
MAIL_USERNAME=null                # SMTPユーザー名
MAIL_PASSWORD=null                # SMTPパスワード
MAIL_ENCRYPTION=null              # 暗号化方式 (tls, ssl, null)
MAIL_FROM_ADDRESS=null            # 送信者メールアドレス
MAIL_FROM_NAME="${APP_NAME}"      # 送信者名